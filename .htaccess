# ============================================================
# .htaccess — Capstone Mobile Quiz System (Render/Apache)
#
# NOTE: The sensitive backend folders (config/, helpers/,
# database/) are protected at the Apache vhost level in
#   apache/000-default.conf  (via <Directory ... Require all denied>).
# Apache does NOT allow <Directory> blocks inside .htaccess, so they
# belong in the server/vhost config, NOT here.
# ============================================================

# Disable directory listing
Options -Indexes

# Baseline browser hardening. These directives are handled by mod_headers,
# enabled in the Render image, and are harmless on local XAMPP when the module
# is unavailable because of the IfModule guard.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Prevent direct access to the database connection file as a fallback
# (<Files> is legal in .htaccess).
<Files "config/database.php">
    Require all denied
</Files>


# Clean admin URLs. Relative substitutions preserve local installation prefixes.
RewriteEngine On
# Render terminates TLS before Apache; never expose its internal port in redirects.
RewriteRule ^ - [E=ADMIN_PUBLIC_ORIGIN:http://%{HTTP_HOST}]
RewriteCond %{HTTPS} =on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} ^https$ [NC]
RewriteRule ^ - [E=ADMIN_PUBLIC_ORIGIN:https://%{HTTP_HOST}]
# Redirect only direct GET/HEAD page requests, never login form POST bodies.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+[^?\ ]*(?:rmc-admin|admin)/(?:login|dashboard)\.php(?:[?\ ]|$) [NC]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)*)(?:rmc-admin|admin)/(?:login|dashboard)\.php$
RewriteRule ^(?:rmc-admin|admin)/(login|dashboard)\.php$ %{ENV:ADMIN_PUBLIC_ORIGIN}%1admin/$1 [R=302,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)*)admin/?$
RewriteRule ^admin/?$ %{ENV:ADMIN_PUBLIC_ORIGIN}%1admin/login [R=302,L]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)*)admin/(?:login|dashboard|logout)/$
RewriteRule ^admin/(login|dashboard|logout)/$ %{ENV:ADMIN_PUBLIC_ORIGIN}%1admin/$1 [R=308,L]
# Normalize legacy module-file URLs before the internal rewrite below. Keep
# non-GET requests internal so form/API payloads are never redirected.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+[^?\ ]*(?:rmc-admin|admin)/(?:users|classes|assessments|reports|logs|maintenance|exam_detail)\.php(?:[?\ ]|$) [NC]
RewriteCond %{REQUEST_URI} ^(/(?:[^/]+/)*)(?:rmc-admin|admin)/(users|classes|assessments|reports|logs|maintenance|exam_detail)\.php$
RewriteRule ^(?:rmc-admin|admin)/(users|classes|assessments|reports|logs|maintenance|exam_detail)\.php$ %{ENV:ADMIN_PUBLIC_ORIGIN}%1admin/$1 [R=302,L,NE]
RewriteRule ^admin/(login|dashboard|logout|ajax)(?:\.php)?$ rmc-admin/$1.php [END]
RewriteRule ^admin/(users|classes|assessments|reports|logs|maintenance|exam_detail)(?:\.php)?/?$ rmc-admin/$1.php [END]
# Catch-all: any other admin/*.php page (users, classes, assessments, reports, logs, maintenance, exam_detail).
RewriteRule ^admin/(.+\.php)$ rmc-admin/$1 [END]
# Only public static assets are aliased; PHP includes remain outside these routes.
RewriteRule ^admin/assets/([a-zA-Z0-9_/-]+\.(?:css|js|jpg|jpeg|png|svg|ico|webp|woff2?))$ rmc-admin/assets/$1 [END]
