# ============================================================
# .dockerignore — files/sources kept OUT of the Render image
# Build context root is the deploy/ folder.
# ============================================================

# --- Local dev / test scripts (must NEVER reach the image) ---
# These live in Backend-PHP/database and Backend-PHP root, but guard
# anyway in case the build context ever widens.
**/setup.php
**_gen_hash.php
**_migrate_add_times.php
**/database/test_*.php
**/database/test_api*.php
database/test_leaderboard.php
Backend-PHP/

# --- Source schema / SQL (not needed at runtime; imported in Phase 3) ---
database/quiz_system.sql
database/*.sql

# --- Local environment & secrets (never commit/build) ---
.env
.env.*
!.env.example
**/config/database.local.php

# --- VCS / IDE / OS junk ---
.git/
.gitignore
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# --- Build artifacts / archive / temp ---
node_modules/
*.zip
*.tar.gz
*.log
*.tmp
__pycache__/
*.pyc

# NOTE: Dockerfile, .dockerignore, render.yaml and apache/ are intentionally
# NOT excluded here. The Dockerfile COPYs apache/<files> into place, so those
# files MUST be part of the build context. Excluding them (as this file once
# did) made the build fail with 'COPY apache/...: not found'.
